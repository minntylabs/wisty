{
  "name": "wisty",
  "version": "2.5.0",
  "description": "Plain text editor",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "tauri:bundle": "tauri build --bundles deb,rpm,appimage",
    "install-local": "bash scripts/install-local.sh",
    "package:user-tarball": "bash scripts/package-user-tarball.sh",
    "release:linux": "npm run tauri:bundle && npm run package:user-tarball",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm run test && npm run typecheck && npm run fmt:rust && npm run lint:rust && npm run test:rust"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kobalte/core": "^0.13.11",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.10"
  }
}
